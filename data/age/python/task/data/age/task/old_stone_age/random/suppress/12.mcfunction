execute unless score old_stone_age bogged_all matches 5.. run scoreboard players set old_stone_age bogged_all 0
execute unless score old_stone_age bogged_all matches 5.. as @a[team=old_stone_age] run scoreboard players operation old_stone_age bogged_all += @s bogged_suppress
bossbar set old_stone_age name ["当前时代 - ", {text:"旧石器时代",color:"#424529"}, "   当前任务 - ", {text:"[围剿] 共同击杀 沼骸 ",color:"red"}, {score:{name:"old_stone_age",objective:"bogged_all"},color:"gray"}, {text:"/5",color:"gray"}]
execute as @a[team=old_stone_age,tag=!task_done,limit=1] if score old_stone_age bogged_all matches 5.. run function age:task/old_stone_age/random/suppress/12_c